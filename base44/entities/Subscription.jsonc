{
  "name": "Subscription",
  "type": "object",
  "properties": {
    "name": { "type": "string", "description": "Name of the subscription service" },
    "category": {
      "type": "string",
      "enum": ["streaming", "software", "fitness", "news", "food", "shopping", "cloud_storage", "music", "gaming", "other"],
      "description": "Category of subscription"
    },
    "cost": { "type": "number", "description": "Monthly cost in dollars" },
    "billing_cycle": {
      "type": "string",
      "enum": ["monthly", "quarterly", "yearly"],
      "default": "monthly"
    },
    "next_billing_date": { "type": "string", "format": "date" },
    "status": {
      "type": "string",
      "enum": ["active", "paused", "cancelled"],
      "default": "active"
    },
    "notes": { "type": "string" }
  },
  "required": ["name", "cost"],
  "rls": {
    "rules": [
      {
        "action": ["create", "read", "update", "delete"],
        "condition": { "created_by": "{{user.email}}" }
      }
    ]
  }
}
